# Copy to .env and fill in your values. Never commit .env to version control.

# Bitwarden / Vaultwarden
BW_URL=https://vault.example.com
BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BW_MASTER_PASSWORD=your-master-password

# KeePass output file password
KEEPASS_PASSWORD=strong-password-for-kdbx-file
BACKUP_OUTPUT_DIR=/backups

# Cron schedule (default: every day at 02:00)
# Examples: every 6h → 0 */6 * * *   |   Monday 03:30 → 30 3 * * 1
BACKUP_SCHEDULE=0 2 * * *

TZ=UTC

# Webhook notification (Slack / ntfy / Gotify) — leave empty to disable
NOTIFY_WEBHOOK_URL=

# SMTP email notification — leave all empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
